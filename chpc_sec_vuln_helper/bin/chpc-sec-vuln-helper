#!/usr/bin/env python3
"""Convenience launcher: lets you run ./bin/chpc-sec-vuln-helper directly
instead of typing `python3 -m chpc_sec_vuln_helper`. Copy the whole
chpc_sec_vuln_helper/ folder anywhere -- unlike the chpc-*-helper script
generators, this one is fully standalone (no chpc_helper_core dependency).
`collect` needs nothing but the Python 3 standard library; the `scan`
command's .docx report needs `python-docx` installed on whichever
machine runs that step (its .html report works either way).
"""
import os
import sys

_THIS_DIR = os.path.dirname(os.path.abspath(__file__))
_PACKAGE_DIR = os.path.dirname(_THIS_DIR)
_PACKAGE_PARENT = os.path.dirname(_PACKAGE_DIR)
sys.path.insert(0, _PACKAGE_PARENT)

from chpc_sec_vuln_helper.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
