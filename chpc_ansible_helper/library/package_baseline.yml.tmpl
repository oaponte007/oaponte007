---
# Installs a package list. The generic ansible.builtin.package module
# auto-detects dnf/yum vs apt from each target host's facts; the
# os-specific option uses dnf/apt directly for finer control (repo
# cache refresh, etc.).
# Generated by CHPC_ansible_helper.
- name: Install baseline packages
  hosts: {{TARGET_HOSTS}}
  become: true
  gather_facts: true

  vars:
    package_list: {{PACKAGE_LIST}}

  tasks:
{{#USE_GENERIC}}
    - name: install packages (auto-detected package manager)
      ansible.builtin.package:
        name: "{{ package_list.split() }}"
        state: present
{{/USE_GENERIC}}
{{#USE_OS_SPECIFIC}}
{{#REFRESH_CACHE}}
    - name: refresh dnf/yum cache
      ansible.builtin.dnf:
        update_cache: true
      when: ansible_facts['os_family'] == "RedHat"

    - name: refresh apt cache
      ansible.builtin.apt:
        update_cache: true
      when: ansible_facts['os_family'] == "Debian"
{{/REFRESH_CACHE}}

    - name: install packages (dnf, RHEL/Rocky)
      ansible.builtin.dnf:
        name: "{{ package_list.split() }}"
        state: present
      when: ansible_facts['os_family'] == "RedHat"

    - name: install packages (apt, Debian)
      ansible.builtin.apt:
        name: "{{ package_list.split() }}"
        state: present
      when: ansible_facts['os_family'] == "Debian"
{{/USE_OS_SPECIFIC}}
