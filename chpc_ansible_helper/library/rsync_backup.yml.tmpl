---
# rsyncs source paths into a dated directory on each target host, then
# prunes old dated backups beyond a retention count.
# Generated by CHPC_ansible_helper.
- name: rsync backup with retention
  hosts: {{TARGET_HOSTS}}
  become: true

  vars:
    backup_sources: {{SOURCE_PATHS}}
    dest_base: {{DEST_BASE}}
    exclude_patterns: {{EXCLUDE_PATTERNS}}
    retention_count: {{RETENTION_COUNT}}

  tasks:
    - name: compute the dated destination directory
      ansible.builtin.set_fact:
        dest_dir: "{{ dest_base }}/{{ now(utc=true).strftime('%Y%m%dT%H%M%SZ') }}"

    - name: ensure the destination directory exists
      ansible.builtin.file:
        path: "{{ dest_dir }}"
        state: directory
        mode: "0755"

    - name: run rsync
      ansible.builtin.command: >-
        rsync -a{{#COMPRESS}}z{{/COMPRESS}}
        {{ exclude_patterns.split() | map('regex_replace', '^', '--exclude ') | join(' ') }}
        {{ backup_sources }} {{ dest_dir }}/
      changed_when: true

    - name: list existing dated backups
      ansible.builtin.find:
        paths: "{{ dest_base }}"
        file_type: directory
      register: existing_backups
      when: retention_count > 0

    - name: prune dated backups beyond the retention count
      ansible.builtin.file:
        path: "{{ item.path }}"
        state: absent
      loop: "{{ existing_backups.files | sort(attribute='mtime', reverse=true) | list }}"
      loop_control:
        label: "{{ item.path }}"
        index_var: backup_index
      when:
        - retention_count > 0
        - backup_index >= retention_count
