---
# Finds files older than N days matching a pattern under given
# directories, and either reports them or deletes them.
# Generated by CHPC_ansible_helper.
- name: Clean up old files
  hosts: {{TARGET_HOSTS}}
  become: true

  vars:
    target_dirs: {{TARGET_DIRS}}
    max_age_days: {{MAX_AGE_DAYS}}
    name_pattern: {{NAME_PATTERN}}

  tasks:
    - name: find matching files older than the age threshold
      ansible.builtin.find:
        paths: "{{ target_dirs.split() }}"
        patterns: "{{ name_pattern }}"
        age: "{{ max_age_days }}d"
        recurse: true
      register: old_files

{{#MODE_REPORT}}
    - name: report matching files
      ansible.builtin.debug:
        msg: "{{ item.path }} ({{ item.size }} bytes)"
      loop: "{{ old_files.files }}"
      loop_control:
        label: "{{ item.path }}"
{{/MODE_REPORT}}
{{#MODE_DELETE}}
    - name: delete matching files
      ansible.builtin.file:
        path: "{{ item.path }}"
        state: absent
      loop: "{{ old_files.files }}"
      loop_control:
        label: "{{ item.path }}"
{{/MODE_DELETE}}
