---
# Runs the guarded command (single-instance guarded via flock) while
# holding an exclusive lock on each target host, so two overlapping
# runs never execute it at the same time on the same machine.
# Generated by CHPC_ansible_helper.
- name: {{COMMAND_DESCRIPTION}}
  hosts: {{TARGET_HOSTS}}
  become: true

  vars:
    lock_file_path: {{LOCK_FILE_PATH}}
    guarded_command: {{COMMAND_TO_RUN}}

  tasks:
{{#LOCK_SKIP}}
    - name: run under a non-blocking lock (skip if already running)
      # flock's exit code is ambiguous between "lock busy" and "the
      # guarded command itself exited non-zero" when used with -c --
      # a known limitation of combining both concerns in one exit
      # code, not something this playbook can fully disambiguate.
      # argv form (not a plain command string) so the guarded command's
      # own content is passed through to flock -c verbatim, whatever it
      # contains, rather than being re-split by Ansible's own parsing.
      ansible.builtin.command:
        argv:
          - flock
          - -n
          - "{{ lock_file_path }}"
          - -c
          - "{{ guarded_command }}"
      register: lock_result
      failed_when: false
      changed_when: lock_result.rc == 0
{{/LOCK_SKIP}}
{{#LOCK_WAIT}}
    - name: run under a blocking lock (wait for any other run to finish)
      ansible.builtin.command:
        argv:
          - flock
          - "{{ lock_file_path }}"
          - -c
          - "{{ guarded_command }}"
      changed_when: true
{{/LOCK_WAIT}}
