---
# Archives log files older than N days into a timestamped archive.
# Generated by CHPC_ansible_helper.
- name: Archive old logs
  hosts: {{TARGET_HOSTS}}
  become: true

  vars:
    log_dir: {{LOG_DIR}}
    max_age_days: {{MAX_AGE_DAYS}}
    archive_dir: {{ARCHIVE_DIR}}

  tasks:
    - name: ensure the archive directory exists
      ansible.builtin.file:
        path: "{{ archive_dir }}"
        state: directory
        mode: "0755"

    - name: find log files older than the age threshold
      ansible.builtin.find:
        paths: "{{ log_dir }}"
        age: "{{ max_age_days }}d"
        recurse: false
      register: old_logs

    - name: build a timestamp for the archive filename
      ansible.builtin.set_fact:
        archive_stamp: "{{ now(utc=true).strftime('%Y%m%dT%H%M%SZ') }}"
      when: old_logs.files | length > 0

    - name: archive the old log files
      ansible.builtin.shell: >-
        tar -czf {{ archive_dir }}/logs-{{ archive_stamp }}.tar.gz
        -C {{ log_dir }} {{ old_logs.files | map(attribute='path') | map('basename') | join(' ') }}
      when: old_logs.files | length > 0
      changed_when: true

{{#DELETE_ORIGINALS}}
    - name: remove the original files after archiving
      ansible.builtin.file:
        path: "{{ item.path }}"
        state: absent
      loop: "{{ old_logs.files }}"
      loop_control:
        label: "{{ item.path }}"
      when: old_logs.files | length > 0
{{/DELETE_ORIGINALS}}
