---
# {{#ACTION_DRAIN}}Drains{{/ACTION_DRAIN}}{{#ACTION_RESUME}}Resumes{{/ACTION_RESUME}} the node(s) listed below. Run from a
# management/login node that has scontrol or pbsnodes available.
# Generated by CHPC_ansible_helper.
- name: {{#ACTION_DRAIN}}Drain{{/ACTION_DRAIN}}{{#ACTION_RESUME}}Resume{{/ACTION_RESUME}} cluster node(s)
  hosts: localhost
  connection: local
  gather_facts: false

  vars:
    node_list: {{NODE_LIST}}
    reason: {{REASON}}

  tasks:
{{#REQUIRE_CONFIRMATION}}
    - name: confirm before acting
      ansible.builtin.pause:
        prompt: "About to {{#ACTION_DRAIN}}DRAIN{{/ACTION_DRAIN}}{{#ACTION_RESUME}}RESUME{{/ACTION_RESUME}} node(s) {{ node_list }} -- type YES to continue"
      register: confirmation

    - name: abort if not confirmed
      ansible.builtin.fail:
        msg: "Not confirmed. Aborting, nothing changed."
      when: confirmation.user_input != "YES"
{{/REQUIRE_CONFIRMATION}}

{{#USE_SLURM}}
{{#ACTION_DRAIN}}
    - name: drain node(s) (Slurm)
      ansible.builtin.command:
        argv:
          - scontrol
          - update
          - "NodeName={{ item }}"
          - State=DRAIN
          - "Reason={{ reason }}"
      loop: "{{ node_list.split() }}"
      changed_when: true
{{/ACTION_DRAIN}}
{{#ACTION_RESUME}}
    - name: resume node(s) (Slurm)
      ansible.builtin.command:
        argv:
          - scontrol
          - update
          - "NodeName={{ item }}"
          - State=RESUME
      loop: "{{ node_list.split() }}"
      changed_when: true
{{/ACTION_RESUME}}
{{/USE_SLURM}}
{{#USE_PBS}}
{{#ACTION_DRAIN}}
    - name: offline node(s) (PBS/PBS Pro)
      ansible.builtin.command:
        argv:
          - pbsnodes
          - -o
          - -N
          - "{{ reason }}"
          - "{{ item }}"
      loop: "{{ node_list.split() }}"
      changed_when: true
{{/ACTION_DRAIN}}
{{#ACTION_RESUME}}
    - name: clear offline on node(s) (PBS/PBS Pro)
      ansible.builtin.command:
        argv:
          - pbsnodes
          - -c
          - "{{ item }}"
      loop: "{{ node_list.split() }}"
      changed_when: true
{{/ACTION_RESUME}}
{{/USE_PBS}}
