---
# Checks a systemd service; restarts with backoff if it's not active,
# and logs the final outcome.
# Generated by CHPC_ansible_helper.
- name: Service watchdog
  hosts: {{TARGET_HOSTS}}
  become: true

  vars:
    watched_service: {{SERVICE_NAME}}
    max_attempts: {{MAX_RESTART_ATTEMPTS}}
    retry_delay_seconds: {{RETRY_DELAY_SECONDS}}

  tasks:
    - name: check whether the service is active
      ansible.builtin.systemd:
        name: "{{ watched_service }}"
      register: service_status
      changed_when: false

    - name: restart the service with backoff until it is actually active
      ansible.builtin.systemd:
        name: "{{ watched_service }}"
        state: restarted
      register: restart_result
      until: restart_result.status.ActiveState == "active"
      retries: "{{ max_attempts }}"
      delay: "{{ retry_delay_seconds }}"
      when: service_status.status.ActiveState != "active"

{{#ALERT_VIA_LOGGER}}
    - name: alert via syslog if it never came back up
      ansible.builtin.command: >-
        logger -p daemon.err -t chpc-ansible-helper
        "watchdog: {{ watched_service }} failed to restart after {{ max_attempts }} attempt(s)"
      when:
        - service_status.status.ActiveState != "active"
        - restart_result.status.ActiveState != "active"
      changed_when: true
{{/ALERT_VIA_LOGGER}}
