---
# Waits until a chosen condition is true.
# Generated by CHPC_ansible_helper.
- name: Wait for a condition
  hosts: {{TARGET_HOSTS}}
  become: true

  vars:
    wait_host: {{HOST}}
    wait_port: {{PORT}}
    wait_file_path: {{FILE_PATH}}
    wait_service_name: {{SERVICE_NAME}}
    wait_process_name: {{PROCESS_NAME}}
    wait_timeout_seconds: {{WAIT_TIMEOUT_SECONDS}}
    wait_retries: {{RETRIES}}
    wait_poll_interval_seconds: {{POLL_INTERVAL_SECONDS}}

  tasks:
{{#WAIT_PORT}}
    - name: wait for TCP port to open
      ansible.builtin.wait_for:
        host: "{{ wait_host }}"
        port: "{{ wait_port }}"
        timeout: "{{ wait_timeout_seconds }}"
{{/WAIT_PORT}}
{{#WAIT_FILE}}
    - name: wait for a file to exist
      ansible.builtin.wait_for:
        path: "{{ wait_file_path }}"
        timeout: "{{ wait_timeout_seconds }}"
{{/WAIT_FILE}}
{{#WAIT_SERVICE}}
    - name: wait for a systemd service to become active
      ansible.builtin.command:
        argv:
          - systemctl
          - is-active
          - --quiet
          - "{{ wait_service_name }}"
      register: service_check
      until: service_check.rc == 0
      retries: "{{ wait_retries }}"
      delay: "{{ wait_poll_interval_seconds }}"
      changed_when: false
{{/WAIT_SERVICE}}
{{#WAIT_PROCESS}}
    - name: wait for a process to be running
      ansible.builtin.command:
        argv:
          - pgrep
          - -x
          - "{{ wait_process_name }}"
      register: process_check
      until: process_check.rc == 0
      retries: "{{ wait_retries }}"
      delay: "{{ wait_poll_interval_seconds }}"
      changed_when: false
{{/WAIT_PROCESS}}
