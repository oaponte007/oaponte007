---
# Installs a recurring schedule for a command -- either a cron entry
# or a systemd timer + service unit pair.
# Generated by CHPC_ansible_helper.
- name: Install a scheduled job
  hosts: {{TARGET_HOSTS}}
  become: true

  vars:
    command_path: {{COMMAND_PATH}}
    cron_schedule: {{CRON_SCHEDULE}}
    timer_on_calendar: {{TIMER_ON_CALENDAR}}
    unit_name: {{UNIT_NAME}}

  tasks:
{{#USE_CRON}}
{{#CRON_ROOT}}
    - name: install the cron entry (root)
      ansible.builtin.cron:
        name: "{{ command_path }}"
        job: "{{ command_path }}"
        minute: "{{ cron_schedule.split()[0] }}"
        hour: "{{ cron_schedule.split()[1] }}"
        day: "{{ cron_schedule.split()[2] }}"
        month: "{{ cron_schedule.split()[3] }}"
        weekday: "{{ cron_schedule.split()[4] }}"
        user: root
{{/CRON_ROOT}}
{{#CRON_CURRENT_USER}}
    - name: install the cron entry (connecting user)
      ansible.builtin.cron:
        name: "{{ command_path }}"
        job: "{{ command_path }}"
        minute: "{{ cron_schedule.split()[0] }}"
        hour: "{{ cron_schedule.split()[1] }}"
        day: "{{ cron_schedule.split()[2] }}"
        month: "{{ cron_schedule.split()[3] }}"
        weekday: "{{ cron_schedule.split()[4] }}"
        user: "{{ ansible_user_id }}"
{{/CRON_CURRENT_USER}}
{{/USE_CRON}}
{{#USE_TIMER}}
    - name: write the systemd service unit
      ansible.builtin.copy:
        dest: "/etc/systemd/system/{{ unit_name }}.service"
        content: |
          [Unit]
          Description={{ unit_name }} (installed by CHPC_ansible_helper)

          [Service]
          Type=oneshot
          ExecStart={{ command_path }}
        mode: "0644"

    - name: write the systemd timer unit
      ansible.builtin.copy:
        dest: "/etc/systemd/system/{{ unit_name }}.timer"
        content: |
          [Unit]
          Description={{ unit_name }} timer (installed by CHPC_ansible_helper)

          [Timer]
          OnCalendar={{ timer_on_calendar }}
          Persistent=true

          [Install]
          WantedBy=timers.target
        mode: "0644"
      register: timer_unit_file

    - name: reload systemd if the timer unit changed
      ansible.builtin.systemd:
        daemon_reload: true
      when: timer_unit_file.changed

    - name: enable and start the timer
      ansible.builtin.systemd:
        name: "{{ unit_name }}.timer"
        enabled: true
        state: started
{{/USE_TIMER}}
