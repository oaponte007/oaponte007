---
# Verifies mount points are present{{#CHECK_WRITABLE}}, writable{{/CHECK_WRITABLE}}, and have enough free space.
# Generated by CHPC_ansible_helper.
- name: Validate mount points
  hosts: {{TARGET_HOSTS}}
  become: true
  gather_facts: true

  vars:
    mount_list: {{MOUNT_LIST}}
    min_free_percent: {{MIN_FREE_PERCENT}}

  tasks:
    - name: check each mount point is present
      ansible.builtin.command: mountpoint -q {{ item }}
      loop: "{{ mount_list.split() }}"
      register: mount_check
      failed_when: false
      changed_when: false

    - name: fail on any missing mount
      ansible.builtin.fail:
        msg: "{{ item.item }} is not mounted"
      loop: "{{ mount_check.results }}"
      loop_control:
        label: "{{ item.item }}"
      when: item.rc != 0

{{#CHECK_WRITABLE}}
    - name: verify each mount is writable
      ansible.builtin.command: test -w {{ item }}
      loop: "{{ mount_list.split() }}"
      register: writable_check
      failed_when: false
      changed_when: false

    - name: fail on any non-writable mount
      ansible.builtin.fail:
        msg: "{{ item.item }} is not writable"
      loop: "{{ writable_check.results }}"
      loop_control:
        label: "{{ item.item }}"
      when: item.rc != 0
{{/CHECK_WRITABLE}}

    - name: check free space on each configured mount
      ansible.builtin.assert:
        that:
          - (item.size_available / item.size_total * 100) >= min_free_percent
        fail_msg: "{{ item.mount }} has only {{ (item.size_available / item.size_total * 100) | round(1) }}% free (need >= {{ min_free_percent }}%)"
        success_msg: "{{ item.mount }} has enough free space"
      loop: "{{ ansible_facts.mounts | selectattr('mount', 'in', mount_list.split()) | list }}"
      loop_control:
        label: "{{ item.mount }}"
      when: min_free_percent > 0
