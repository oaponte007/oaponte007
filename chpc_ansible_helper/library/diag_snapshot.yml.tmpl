---
# Collects a diagnostics snapshot on each target host and fetches the
# resulting tarball back to the controller.
# Generated by CHPC_ansible_helper.
- name: Collect diagnostics snapshot
  hosts: {{TARGET_HOSTS}}
  become: true
  gather_facts: true

  vars:
    remote_output_dir: {{OUTPUT_DIR}}
    fetch_dest_dir: {{FETCH_DEST_DIR}}

  tasks:
    - name: create a working directory
      ansible.builtin.tempfile:
        state: directory
      register: workdir

    - name: collect system info
      ansible.builtin.shell: >-
        { uname -a; echo; cat /etc/os-release 2>/dev/null; }
        > {{ workdir.path }}/system_info.txt
      changed_when: false

    - name: collect disk usage
      ansible.builtin.shell: df -h > {{ workdir.path }}/disk.txt
      changed_when: false

    - name: collect network config
      ansible.builtin.shell: ip addr > {{ workdir.path }}/network.txt
      changed_when: false

    - name: collect process list
      ansible.builtin.shell: ps aux > {{ workdir.path }}/processes.txt
      changed_when: false

    - name: collect dmesg
      ansible.builtin.shell: dmesg > {{ workdir.path }}/dmesg.txt 2>&1 || true
      changed_when: false

{{#INCLUDE_JOURNAL}}
    - name: collect the last 500 lines of the journal
      ansible.builtin.shell: journalctl -n 500 --no-pager > {{ workdir.path }}/journal.txt 2>&1 || true
      changed_when: false
{{/INCLUDE_JOURNAL}}

{{#INCLUDE_SCHEDULER_STATUS}}
    - name: collect scheduler status, if Slurm or PBS is installed
      ansible.builtin.shell: >-
        if command -v sinfo >/dev/null 2>&1; then sinfo -N -l;
        elif command -v pbsnodes >/dev/null 2>&1; then pbsnodes -a;
        else echo "No Slurm or PBS scheduler commands found."; fi
        > {{ workdir.path }}/scheduler_status.txt 2>&1
      changed_when: false
{{/INCLUDE_SCHEDULER_STATUS}}

    - name: compute the bundle filename
      ansible.builtin.set_fact:
        bundle_path: "{{ remote_output_dir }}/diag-{{ inventory_hostname }}-{{ now(utc=true).strftime('%Y%m%dT%H%M%SZ') }}.tar.gz"

    - name: build the timestamped bundle
      ansible.builtin.shell: tar -czf {{ bundle_path }} -C {{ workdir.path }} .
      changed_when: true

    - name: fetch the bundle back to the controller
      ansible.builtin.fetch:
        src: "{{ bundle_path }}"
        dest: "{{ fetch_dest_dir }}/"
        flat: true

    - name: remove the working directory
      ansible.builtin.file:
        path: "{{ workdir.path }}"
        state: absent
