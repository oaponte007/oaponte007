---
# Creates or updates a user account, optionally adding it to a group
# and installing an SSH public key into authorized_keys.
# Generated by CHPC_ansible_helper.
- name: Provision a user account
  hosts: {{TARGET_HOSTS}}
  become: true

  vars:
    provision_username: {{USERNAME}}
    provision_group: {{PRIMARY_GROUP}}
    provision_ssh_key: {{SSH_PUBLIC_KEY}}

  tasks:
    - name: ensure the group exists
      ansible.builtin.group:
        name: "{{ provision_group }}"
        state: present
      when: provision_group | length > 0

    - name: create or update the user account
      ansible.builtin.user:
        name: "{{ provision_username }}"
        groups: "{{ provision_group if provision_group | length > 0 else omit }}"
        append: true
        create_home: true
{{#DISABLE_PASSWORD_LOGIN}}
        password_lock: true
{{/DISABLE_PASSWORD_LOGIN}}
      register: provisioned_user

    - name: ensure the .ssh directory has correct permissions
      ansible.builtin.file:
        path: "{{ provisioned_user.home }}/.ssh"
        state: directory
        owner: "{{ provision_username }}"
        group: "{{ provision_group if provision_group | length > 0 else provision_username }}"
        mode: "0700"
      when: provision_ssh_key | length > 0

    - name: install the SSH public key
      ansible.builtin.lineinfile:
        path: "{{ provisioned_user.home }}/.ssh/authorized_keys"
        line: "{{ provision_ssh_key }}"
        create: true
        owner: "{{ provision_username }}"
        group: "{{ provision_group if provision_group | length > 0 else provision_username }}"
        mode: "0600"
      when: provision_ssh_key | length > 0
