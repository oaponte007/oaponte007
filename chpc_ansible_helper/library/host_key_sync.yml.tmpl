---
# Populates known_hosts on the controller for each target host, and/or
# pushes an SSH public key into each target's authorized_keys.
# Generated by CHPC_ansible_helper.
{{#UPDATE_KNOWN_HOSTS}}
- name: Scan and record host keys (controller-side)
  hosts: localhost
  connection: local
  gather_facts: false

  vars:
    target_hosts_group: {{TARGET_HOSTS}}
    known_hosts_file: {{KNOWN_HOSTS_FILE}}

  tasks:
    - name: scan each target host's SSH key into known_hosts
      ansible.builtin.shell: >-
        ssh-keyscan -H {{ item }} >> {{ known_hosts_file }}
      loop: "{{ groups[target_hosts_group] | default([]) }}"
      changed_when: true
{{/UPDATE_KNOWN_HOSTS}}

- name: Install SSH public key on target hosts
  hosts: {{TARGET_HOSTS}}
  become: true

  vars:
    ssh_target_user: {{SSH_USER}}
    ssh_public_key: {{SSH_PUBLIC_KEY}}

  tasks:
    - name: ensure the user's .ssh directory has correct permissions
      ansible.builtin.file:
        path: "~{{ ssh_target_user }}/.ssh"
        state: directory
        owner: "{{ ssh_target_user }}"
        mode: "0700"
      when: ssh_public_key | length > 0

    - name: install the SSH public key
      ansible.builtin.lineinfile:
        path: "~{{ ssh_target_user }}/.ssh/authorized_keys"
        line: "{{ ssh_public_key }}"
        create: true
        owner: "{{ ssh_target_user }}"
        mode: "0600"
      when: ssh_public_key | length > 0
