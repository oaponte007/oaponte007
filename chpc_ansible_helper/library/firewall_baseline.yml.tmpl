---
# Applies a firewall baseline across mixed RHEL/Rocky (firewalld) and
# Debian (ufw) inventory -- one playbook, auto-detected per host via
# ansible_facts['os_family'].
# Generated by CHPC_ansible_helper.
- name: Apply firewall baseline
  hosts: {{TARGET_HOSTS}}
  become: true
  gather_facts: true

  vars:
    allowed_services: {{ALLOWED_SERVICES}}
    allowed_ports: {{ALLOWED_PORTS}}

  tasks:
    - name: allow services (firewalld)
      ansible.builtin.command: firewall-cmd --permanent --add-service={{ item }}
      loop: "{{ allowed_services.split() }}"
      when: ansible_facts['os_family'] == "RedHat"
      changed_when: true

    - name: allow ports (firewalld)
      ansible.builtin.command: firewall-cmd --permanent --add-port={{ item }}
      loop: "{{ allowed_ports.split() }}"
      when: ansible_facts['os_family'] == "RedHat"
      changed_when: true

    - name: reload firewalld
      ansible.builtin.command: firewall-cmd --reload
      when:
        - ansible_facts['os_family'] == "RedHat"
        - (allowed_services.split() | length > 0) or (allowed_ports.split() | length > 0)
      changed_when: true

    - name: allow services (ufw)
      ansible.builtin.command: ufw allow {{ item }}
      loop: "{{ allowed_services.split() }}"
      when: ansible_facts['os_family'] == "Debian"
      changed_when: true

    - name: allow ports (ufw)
      ansible.builtin.command: ufw allow {{ item }}
      loop: "{{ allowed_ports.split() }}"
      when: ansible_facts['os_family'] == "Debian"
      changed_when: true

    - name: enable ufw
      ansible.builtin.command: ufw --force enable
      when: ansible_facts['os_family'] == "Debian"
      changed_when: true
