#!/usr/bin/env python3
"""Convenience launcher: lets you run ./bin/chpc-bash-helper directly
instead of typing `python3 -m chpc_bash_helper` from the repo root. Copy
the chpc_bash_helper/ folder AND its sibling chpc_helper_core/ folder
onto the airgapped machine (same parent directory) and either works --
nothing here needs installing (no pip, no network).
"""
import os
import sys

_THIS_DIR = os.path.dirname(os.path.abspath(__file__))  # .../chpc_bash_helper/bin
_PACKAGE_DIR = os.path.dirname(_THIS_DIR)  # .../chpc_bash_helper
_PACKAGE_PARENT = os.path.dirname(_PACKAGE_DIR)  # the directory chpc_bash_helper/ lives in
sys.path.insert(0, _PACKAGE_PARENT)

from chpc_bash_helper.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
