#!/usr/bin/env bash
# Watchdog for the "{{SERVICE_NAME}}" systemd service.
# Generated by CHPC_bash_helper.
set -uo pipefail

SERVICE="{{SERVICE_NAME}}.service"
MAX_ATTEMPTS={{MAX_RESTART_ATTEMPTS}}
DELAY={{RETRY_DELAY_SECONDS}}

log() { printf '[%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*"; }

if systemctl is-active --quiet "$SERVICE"; then
    log "$SERVICE is active. Nothing to do."
    exit 0
fi

log "$SERVICE is not active. Attempting to restart (up to $MAX_ATTEMPTS time(s))."
attempt=1
while [[ "$attempt" -le "$MAX_ATTEMPTS" ]]; do
    log "Restart attempt $attempt/$MAX_ATTEMPTS"
    systemctl restart "$SERVICE" || true
    sleep "$DELAY"
    if systemctl is-active --quiet "$SERVICE"; then
        log "$SERVICE is active again after attempt $attempt."
        exit 0
    fi
    attempt=$(( attempt + 1 ))
done

log "$SERVICE did not come back up after $MAX_ATTEMPTS attempt(s)."
{{#ALERT_VIA_LOGGER}}
logger -p daemon.err -t chpc-bash-helper "watchdog: $SERVICE failed to restart after $MAX_ATTEMPTS attempt(s)"
{{/ALERT_VIA_LOGGER}}
exit 1
