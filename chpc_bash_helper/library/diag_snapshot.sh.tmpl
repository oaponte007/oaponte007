#!/usr/bin/env bash
# Collects a diagnostics snapshot into a timestamped tarball.
# Generated by CHPC_bash_helper.
set -uo pipefail

OUTPUT_DIR="{{OUTPUT_DIR}}"
STAMP="$(date -u +'%Y%m%dT%H%M%SZ')"
WORKDIR="$(mktemp -d)"
BUNDLE="$OUTPUT_DIR/diag-$(hostname -s 2>/dev/null || hostname)-$STAMP.tar.gz"

log() { printf '[%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*"; }
cleanup() { rm -rf "$WORKDIR"; }
trap cleanup EXIT

log "Collecting system info"
{
    echo "== uname -a =="; uname -a
    echo; echo "== os-release =="; cat /etc/os-release 2>/dev/null
} > "$WORKDIR/system_info.txt" 2>&1

echo "== free -m ==" > "$WORKDIR/memory.txt"; free -m >> "$WORKDIR/memory.txt" 2>&1
echo "== df -h ==" > "$WORKDIR/disk.txt"; df -h >> "$WORKDIR/disk.txt" 2>&1
echo "== ip addr ==" > "$WORKDIR/network.txt"; ip addr >> "$WORKDIR/network.txt" 2>&1
echo "== ps aux ==" > "$WORKDIR/processes.txt"; ps aux >> "$WORKDIR/processes.txt" 2>&1
dmesg > "$WORKDIR/dmesg.txt" 2>&1 || echo "dmesg not available/permitted" > "$WORKDIR/dmesg.txt"

{{#INCLUDE_JOURNAL}}
log "Collecting journal (last 500 lines)"
journalctl -n 500 --no-pager > "$WORKDIR/journal.txt" 2>&1 || echo "journalctl not available" > "$WORKDIR/journal.txt"
{{/INCLUDE_JOURNAL}}

{{#INCLUDE_SCHEDULER_STATUS}}
log "Collecting scheduler status (if present)"
if command -v sinfo >/dev/null 2>&1; then
    sinfo -N -l > "$WORKDIR/scheduler_status.txt" 2>&1
elif command -v pbsnodes >/dev/null 2>&1; then
    pbsnodes -a > "$WORKDIR/scheduler_status.txt" 2>&1
else
    echo "No Slurm or PBS scheduler commands found." > "$WORKDIR/scheduler_status.txt"
fi
{{/INCLUDE_SCHEDULER_STATUS}}

log "Building $BUNDLE"
tar -czf "$BUNDLE" -C "$WORKDIR" .
log "Done: $BUNDLE"
