#!/usr/bin/env bash
# Applies a firewall baseline: services [{{ALLOWED_SERVICES}}], ports [{{ALLOWED_PORTS}}].
# Generated by CHPC_bash_helper.
set -euo pipefail

SERVICES="{{ALLOWED_SERVICES}}"
PORTS="{{ALLOWED_PORTS}}"

log() { printf '[%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*"; }

{{#USE_FIREWALLD}}
for svc in $SERVICES; do
    log "Allowing service: $svc"
    firewall-cmd --permanent --add-service="$svc"
done
for port in $PORTS; do
    log "Allowing port: $port"
    firewall-cmd --permanent --add-port="$port"
done
log "Reloading firewalld."
firewall-cmd --reload
{{/USE_FIREWALLD}}
{{#USE_UFW}}
for svc in $SERVICES; do
    log "Allowing service: $svc"
    ufw allow "$svc"
done
for port in $PORTS; do
    proto="${port##*/}"
    num="${port%%/*}"
    log "Allowing port: $num/$proto"
    ufw allow "$num/$proto"
done
log "Enabling ufw (if not already)."
ufw --force enable
{{/USE_UFW}}

log "Done."
