#!/usr/bin/env bash
# {{#MODE_REPORT}}Reports{{/MODE_REPORT}}{{#MODE_DELETE}}Deletes{{/MODE_DELETE}} files older than {{MAX_AGE_DAYS}} day(s) matching '{{NAME_PATTERN}}' under the directories below.
# Generated by CHPC_bash_helper.
set -uo pipefail

DIRS="{{TARGET_DIRS}}"
MAX_AGE_DAYS={{MAX_AGE_DAYS}}
NAME_PATTERN="{{NAME_PATTERN}}"

log() { printf '[%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*"; }

for dir in $DIRS; do
    if [[ ! -d "$dir" ]]; then
        log "Skipping $dir (not a directory)"
        continue
    fi
    log "Scanning $dir for files older than ${MAX_AGE_DAYS}d matching '$NAME_PATTERN'"
{{#MODE_REPORT}}
    find "$dir" -type f -name "$NAME_PATTERN" -mtime "+${MAX_AGE_DAYS}" -printf '%TY-%Tm-%Td  %10s bytes  %p\n'
{{/MODE_REPORT}}
{{#MODE_DELETE}}
    find "$dir" -type f -name "$NAME_PATTERN" -mtime "+${MAX_AGE_DAYS}" -print -delete
{{/MODE_DELETE}}
done

log "Done."
