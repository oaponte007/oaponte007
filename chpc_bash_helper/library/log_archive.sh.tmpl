#!/usr/bin/env bash
# Archives log files in {{LOG_DIR}} older than {{MAX_AGE_DAYS}} day(s) into {{ARCHIVE_DIR}}.
# Generated by CHPC_bash_helper.
set -euo pipefail

LOG_DIR="{{LOG_DIR}}"
MAX_AGE_DAYS={{MAX_AGE_DAYS}}
ARCHIVE_DIR="{{ARCHIVE_DIR}}"
STAMP="$(date -u +'%Y%m%dT%H%M%SZ')"
ARCHIVE_FILE="$ARCHIVE_DIR/logs-$STAMP.tar.gz"

log() { printf '[%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*"; }

mkdir -p "$ARCHIVE_DIR"

mapfile -d '' -t OLD_FILES < <(find "$LOG_DIR" -maxdepth 1 -type f -mtime "+${MAX_AGE_DAYS}" -print0)

if [[ "${#OLD_FILES[@]}" -eq 0 ]]; then
    log "No files older than ${MAX_AGE_DAYS}d in $LOG_DIR."
    exit 0
fi

log "Archiving ${#OLD_FILES[@]} file(s) into $ARCHIVE_FILE"
tar -czf "$ARCHIVE_FILE" -C "$LOG_DIR" "${OLD_FILES[@]##*/}"

{{#DELETE_ORIGINALS}}
log "Removing originals"
rm -f "${OLD_FILES[@]}"
{{/DELETE_ORIGINALS}}

log "Done. Archive: $ARCHIVE_FILE"
