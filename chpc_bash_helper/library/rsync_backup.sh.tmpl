#!/usr/bin/env bash
# rsyncs {{SOURCE_PATHS}} into a dated directory under {{DEST_BASE}}, then
# prunes old dated backups beyond the retention count.
# Generated by CHPC_bash_helper.
set -euo pipefail

SOURCES="{{SOURCE_PATHS}}"
DEST_BASE="{{DEST_BASE}}"
RETENTION={{RETENTION_COUNT}}
STAMP="$(date -u +'%Y%m%dT%H%M%SZ')"
DEST_DIR="$DEST_BASE/$STAMP"

log() { printf '[%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*"; }

RSYNC_OPTS=(-a)
{{#COMPRESS}}
RSYNC_OPTS+=(-z)
{{/COMPRESS}}

EXCLUDES="{{EXCLUDE_PATTERNS}}"
for pattern in $EXCLUDES; do
    RSYNC_OPTS+=(--exclude "$pattern")
done

mkdir -p "$DEST_DIR"
log "Backing up to $DEST_DIR"
rsync "${RSYNC_OPTS[@]}" $SOURCES "$DEST_DIR/"

if [[ "$RETENTION" -gt 0 ]]; then
    log "Pruning to the $RETENTION most recent dated backup(s) in $DEST_BASE"
    ls -1dt "$DEST_BASE"/*/ 2>/dev/null | tail -n "+$(( RETENTION + 1 ))" | while read -r old; do
        log "Removing old backup $old"
        rm -rf "$old"
    done
fi

log "Done. Backup at $DEST_DIR"
