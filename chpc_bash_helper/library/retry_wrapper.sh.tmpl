#!/usr/bin/env bash
# Retries: {{COMMAND_DESCRIPTION}}
# Generated by CHPC_bash_helper.
set -uo pipefail  # deliberately not -e: a failing attempt is expected and handled below

MAX_ATTEMPTS={{MAX_ATTEMPTS}}
DELAY={{INITIAL_DELAY_SECONDS}}

log() { printf '[%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*"; }

attempt=1
while [[ "$attempt" -le "$MAX_ATTEMPTS" ]]; do
    log "Attempt $attempt/$MAX_ATTEMPTS: {{COMMAND_DESCRIPTION}}"
    if {{COMMAND_TO_RUN}}; then
        log "Succeeded on attempt $attempt."
        exit 0
    fi
    if [[ "$attempt" -eq "$MAX_ATTEMPTS" ]]; then
        log "Giving up after $MAX_ATTEMPTS attempts."
        exit 1
    fi
    log "Failed. Waiting ${DELAY}s before retrying."
    sleep "$DELAY"
{{#EXPONENTIAL_DELAY}}
    DELAY=$(( DELAY * 2 ))
{{/EXPONENTIAL_DELAY}}
    attempt=$(( attempt + 1 ))
done
