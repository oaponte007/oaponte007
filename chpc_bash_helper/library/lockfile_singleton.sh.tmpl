#!/usr/bin/env bash
# Runs "{{COMMAND_DESCRIPTION}}" while holding an exclusive lock, so two
# overlapping runs (e.g. two cron firings) never execute at the same time.
# Generated by CHPC_bash_helper.
set -euo pipefail

LOCK_FILE="{{LOCK_FILE_PATH}}"
exec 200>"$LOCK_FILE"

log() { printf '[%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*"; }

{{#LOCK_WAIT}}
log "Waiting for lock $LOCK_FILE (another instance may be running)..."
flock 200
{{/LOCK_WAIT}}
{{#LOCK_SKIP}}
if ! flock -n 200; then
    log "Another instance is already running (lock: $LOCK_FILE). Exiting."
    exit 0
fi
{{/LOCK_SKIP}}

log "Lock acquired. Running: {{COMMAND_DESCRIPTION}}"
{{COMMAND_TO_RUN}}
log "Done."
