#!/usr/bin/env bash
# Verifies mount points are present{{#CHECK_WRITABLE}}, writable{{/CHECK_WRITABLE}}, and have enough free space.
# Exit code 0 = all OK, 1 = at least one problem (see stderr for which).
# Generated by CHPC_bash_helper.
set -uo pipefail

MOUNTS="{{MOUNT_LIST}}"
MIN_FREE_PERCENT={{MIN_FREE_PERCENT}}
PROBLEMS=0

log() { printf '[%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*"; }
fail() { log "PROBLEM: $*" >&2; PROBLEMS=$(( PROBLEMS + 1 )); }

for mnt in $MOUNTS; do
    if ! mountpoint -q "$mnt" 2>/dev/null && ! findmnt -rno TARGET "$mnt" >/dev/null 2>&1; then
        fail "$mnt is not mounted"
        continue
    fi

{{#CHECK_WRITABLE}}
    testfile="$mnt/.chpc_mount_check.$$"
    if ! ( : > "$testfile" ) 2>/dev/null; then
        fail "$mnt is not writable"
    else
        rm -f "$testfile"
    fi
{{/CHECK_WRITABLE}}

    if [[ "$MIN_FREE_PERCENT" -gt 0 ]]; then
        used_percent=$(df -P "$mnt" | awk 'NR==2 {gsub("%","",$5); print $5}')
        if [[ -n "$used_percent" ]]; then
            free_percent=$(( 100 - used_percent ))
            if [[ "$free_percent" -lt "$MIN_FREE_PERCENT" ]]; then
                fail "$mnt has only ${free_percent}% free (need >= ${MIN_FREE_PERCENT}%)"
            fi
        fi
    fi
done

if [[ "$PROBLEMS" -gt 0 ]]; then
    log "$PROBLEMS problem(s) found."
    exit 1
fi
log "All mount points OK."
