#!/usr/bin/env bash
# Waits until a chosen condition is true, then exits 0. See check_ready()
# below for exactly what it checks.
# Generated by CHPC_bash_helper.
set -uo pipefail

TIMEOUT={{TIMEOUT_SECONDS}}
INTERVAL={{POLL_INTERVAL_SECONDS}}

log() { printf '[%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*"; }

check_ready() {
{{#WAIT_PORT}}
    (exec 3<>"/dev/tcp/{{HOST}}/{{PORT}}") 2>/dev/null
{{/WAIT_PORT}}
{{#WAIT_FILE}}
    [[ -e "{{FILE_PATH}}" ]]
{{/WAIT_FILE}}
{{#WAIT_SERVICE}}
    systemctl is-active --quiet "{{SERVICE_NAME}}"
{{/WAIT_SERVICE}}
{{#WAIT_PROCESS}}
    pgrep -x "{{PROCESS_NAME}}" >/dev/null
{{/WAIT_PROCESS}}
}

elapsed=0
log "Waiting up to ${TIMEOUT}s (checking every ${INTERVAL}s)"
while ! check_ready; do
    if [[ "$elapsed" -ge "$TIMEOUT" ]]; then
        log "Timed out after ${TIMEOUT}s."
        exit 1
    fi
    sleep "$INTERVAL"
    elapsed=$(( elapsed + INTERVAL ))
done
log "Ready after ${elapsed}s."
