#!/usr/bin/env bash
# Creates or updates the account "{{USERNAME}}".
# Generated by CHPC_bash_helper.
set -euo pipefail

USERNAME="{{USERNAME}}"
GROUP="{{PRIMARY_GROUP}}"
SSH_KEY="{{SSH_PUBLIC_KEY}}"

log() { printf '[%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*"; }

if id -u "$USERNAME" >/dev/null 2>&1; then
    log "$USERNAME already exists; updating."
    if [[ -n "$GROUP" ]]; then
        usermod -aG "$GROUP" "$USERNAME"
    fi
else
    log "Creating $USERNAME."
    if [[ -n "$GROUP" ]]; then
        useradd -m -G "$GROUP" "$USERNAME"
    else
        useradd -m "$USERNAME"
    fi
fi

{{#DISABLE_PASSWORD_LOGIN}}
log "Locking password login for $USERNAME (SSH key only)."
passwd -l "$USERNAME"
{{/DISABLE_PASSWORD_LOGIN}}

if [[ -n "$SSH_KEY" ]]; then
    HOME_DIR="$(getent passwd "$USERNAME" | cut -d: -f6)"
    SSH_DIR="$HOME_DIR/.ssh"
    log "Installing SSH key into $SSH_DIR/authorized_keys"
    mkdir -p "$SSH_DIR"
    touch "$SSH_DIR/authorized_keys"
    grep -qxF "$SSH_KEY" "$SSH_DIR/authorized_keys" || echo "$SSH_KEY" >> "$SSH_DIR/authorized_keys"
    chmod 700 "$SSH_DIR"
    chmod 600 "$SSH_DIR/authorized_keys"
    chown -R "$USERNAME:$USERNAME" "$SSH_DIR"
fi

log "Done."
