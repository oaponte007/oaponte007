#!/usr/bin/env bash
# For each host in {{HOSTS_FILE}}: {{#UPDATE_KNOWN_HOSTS}}update known_hosts{{/UPDATE_KNOWN_HOSTS}} and optionally push an SSH key.
# Generated by CHPC_bash_helper.
set -uo pipefail

HOSTS_FILE="{{HOSTS_FILE}}"
KNOWN_HOSTS_FILE="{{KNOWN_HOSTS_FILE}}"
SSH_KEY="{{SSH_PUBLIC_KEY}}"
SSH_USER="{{SSH_USER}}"

log() { printf '[%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*"; }

if [[ ! -f "$HOSTS_FILE" ]]; then
    log "Hosts file $HOSTS_FILE not found." >&2
    exit 1
fi

while IFS= read -r host; do
    [[ -z "$host" || "$host" == \#* ]] && continue

{{#UPDATE_KNOWN_HOSTS}}
    log "Scanning host key for $host"
    ssh-keyscan -H "$host" >> "$KNOWN_HOSTS_FILE" 2>/dev/null || log "  ssh-keyscan failed for $host"
{{/UPDATE_KNOWN_HOSTS}}

    if [[ -n "$SSH_KEY" ]]; then
        log "Installing SSH key on $host"
        ssh "${SSH_USER}@${host}" "mkdir -p ~/.ssh && chmod 700 ~/.ssh && grep -qxF '$SSH_KEY' ~/.ssh/authorized_keys 2>/dev/null || echo '$SSH_KEY' >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys" \
            || log "  failed to install key on $host"
    fi
done < "$HOSTS_FILE"

log "Done."
