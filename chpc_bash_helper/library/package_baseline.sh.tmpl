#!/usr/bin/env bash
# Installs: {{PACKAGE_LIST}}
# Assumes your repos (local mirror, satellite, etc.) are already
# configured -- this script never reaches out to the internet itself.
# Generated by CHPC_bash_helper.
set -euo pipefail

PACKAGES="{{PACKAGE_LIST}}"

log() { printf '[%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*"; }

{{#USE_DNF}}
PKG_MGR="dnf"
command -v dnf >/dev/null 2>&1 || PKG_MGR="yum"
{{#REFRESH_CACHE}}
log "Refreshing $PKG_MGR metadata cache."
"$PKG_MGR" makecache
{{/REFRESH_CACHE}}
log "Installing with $PKG_MGR: $PACKAGES"
"$PKG_MGR" install -y $PACKAGES
{{/USE_DNF}}
{{#USE_APT}}
{{#REFRESH_CACHE}}
log "Refreshing apt package index."
apt-get update
{{/REFRESH_CACHE}}
log "Installing with apt-get: $PACKAGES"
DEBIAN_FRONTEND=noninteractive apt-get install -y $PACKAGES
{{/USE_APT}}

log "Done."
