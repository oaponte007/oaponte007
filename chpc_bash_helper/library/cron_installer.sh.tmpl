#!/usr/bin/env bash
# Installs a recurring schedule for {{COMMAND_PATH}}.
# Generated by CHPC_bash_helper.
set -euo pipefail

COMMAND="{{COMMAND_PATH}}"

log() { printf '[%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*"; }

{{#USE_CRON}}
CRON_LINE="{{CRON_SCHEDULE}} $COMMAND"
{{#CRON_ROOT}}
TARGET_USER="root"
{{/CRON_ROOT}}
{{#CRON_CURRENT_USER}}
TARGET_USER="$(id -un)"
{{/CRON_CURRENT_USER}}

log "Installing cron entry for $TARGET_USER: $CRON_LINE"
( crontab -u "$TARGET_USER" -l 2>/dev/null | grep -vF "$COMMAND" ; echo "$CRON_LINE" ) | crontab -u "$TARGET_USER" -
log "Installed. Verify with: crontab -u $TARGET_USER -l"
{{/USE_CRON}}

{{#USE_TIMER}}
UNIT="{{UNIT_NAME}}"
SERVICE_FILE="/etc/systemd/system/${UNIT}.service"
TIMER_FILE="/etc/systemd/system/${UNIT}.timer"

log "Writing $SERVICE_FILE"
cat > "$SERVICE_FILE" <<SERVICE_UNIT
[Unit]
Description=$UNIT (installed by CHPC_bash_helper)

[Service]
Type=oneshot
ExecStart=$COMMAND
SERVICE_UNIT

log "Writing $TIMER_FILE"
cat > "$TIMER_FILE" <<TIMER_UNIT
[Unit]
Description=$UNIT timer (installed by CHPC_bash_helper)

[Timer]
OnCalendar={{TIMER_ON_CALENDAR}}
Persistent=true

[Install]
WantedBy=timers.target
TIMER_UNIT

systemctl daemon-reload
systemctl enable --now "${UNIT}.timer"
log "Installed and started ${UNIT}.timer. Verify with: systemctl list-timers ${UNIT}.timer"
{{/USE_TIMER}}
