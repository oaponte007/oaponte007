set -euo pipefail

SCRIPT_NAME="$(basename "$0")"

usage() {
    cat <<USAGE
Usage: $SCRIPT_NAME [options]

{{SCRIPT_PURPOSE}}

Options:
{{#HAS_DRY_RUN}}
  -n, --dry-run     Show what would happen without actually doing it
{{/HAS_DRY_RUN}}
  -h, --help        Show this help and exit
USAGE
}

{{#LOG_STDOUT_ONLY}}
log() {
    printf '[%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*"
}
{{/LOG_STDOUT_ONLY}}
{{#LOG_TO_FILE}}
LOG_FILE="{{LOG_FILE_PATH}}"
log() {
    printf '[%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*" | tee -a "$LOG_FILE"
}
{{/LOG_TO_FILE}}

on_error() {
    local exit_code=$? line_no=$1
    log "ERROR: $SCRIPT_NAME failed at line $line_no (exit code $exit_code)"
    exit "$exit_code"
}
trap 'on_error $LINENO' ERR

{{#HAS_DRY_RUN}}
DRY_RUN=0
{{/HAS_DRY_RUN}}

# --- SECTION: argument parsing -------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
{{#HAS_DRY_RUN}}
        -n|--dry-run)
            DRY_RUN=1
            shift
            ;;
{{/HAS_DRY_RUN}}
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage
            exit 1
            ;;
    esac
done

