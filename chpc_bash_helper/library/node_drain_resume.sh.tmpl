#!/usr/bin/env bash
# {{#ACTION_DRAIN}}Drains{{/ACTION_DRAIN}}{{#ACTION_RESUME}}Resumes{{/ACTION_RESUME}} the node(s) listed below.
# Generated by CHPC_bash_helper.
set -euo pipefail

NODES="{{NODE_LIST}}"
REASON="{{REASON}}"

log() { printf '[%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*"; }

{{#REQUIRE_CONFIRMATION}}
echo "About to {{#ACTION_DRAIN}}DRAIN{{/ACTION_DRAIN}}{{#ACTION_RESUME}}RESUME{{/ACTION_RESUME}} node(s): $NODES"
{{#ACTION_DRAIN}}
echo "Reason: $REASON"
{{/ACTION_DRAIN}}
read -r -p "Type YES to continue: " CONFIRM
if [[ "$CONFIRM" != "YES" ]]; then
    log "Not confirmed. Aborting, nothing changed."
    exit 1
fi
{{/REQUIRE_CONFIRMATION}}

for node in $NODES; do
{{#USE_SLURM}}
{{#ACTION_DRAIN}}
    log "Draining $node (Slurm): $REASON"
    scontrol update NodeName="$node" State=DRAIN Reason="$REASON"
{{/ACTION_DRAIN}}
{{#ACTION_RESUME}}
    log "Resuming $node (Slurm)"
    scontrol update NodeName="$node" State=RESUME
{{/ACTION_RESUME}}
{{/USE_SLURM}}
{{#USE_PBS}}
{{#ACTION_DRAIN}}
    log "Offlining $node (PBS/PBS Pro): $REASON"
    pbsnodes -o -N "$REASON" "$node"
{{/ACTION_DRAIN}}
{{#ACTION_RESUME}}
    log "Clearing offline on $node (PBS/PBS Pro)"
    pbsnodes -c "$node"
{{/ACTION_RESUME}}
{{/USE_PBS}}
done

log "Done."
