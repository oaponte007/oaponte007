    <definition class="patch" id="oval:com.redhat.rhsa:def:20242000" version="632">
      <metadata>
        <title>RHSA-2024:2000: openssl security update (Important)</title>
        <affected family="unix">
          <platform>Red Hat Enterprise Linux 9</platform>
        </affected>
        <reference source="RHSA" ref_id="RHSA-2024:2000" ref_url="https://access.redhat.com/errata/RHSA-2024:2000"/>
        <reference source="CVE" ref_id="CVE-2024-1111" ref_url="https://access.redhat.com/security/cve/CVE-2024-1111"/>
        <description>A flaw was found in openssl that could allow a remote attacker to cause a denial of service.</description>
        <advisory from="secalert@redhat.com">
          <severity>Important</severity>
          <cve href="https://access.redhat.com/security/cve/CVE-2024-1111" cvss3="7.5/CVSS:3.1" impact="important" public="20240115">CVE-2024-1111</cve>
        </advisory>
      </metadata>
      <criteria operator="AND">
        <criterion test_ref="oval:com.redhat.rhsa:tst:9000001" comment="Red Hat Enterprise Linux 9 is installed"/>
        <criteria operator="OR">
          <criterion test_ref="oval:com.redhat.rhsa:tst:20242000001" comment="openssl is earlier than 1:3.0.7-27.el9_5"/>
          <criterion test_ref="oval:com.redhat.rhsa:tst:20242000002" comment="openssl-libs is earlier than 1:3.0.7-27.el9_5"/>
        </criteria>
      </criteria>
    </definition>

