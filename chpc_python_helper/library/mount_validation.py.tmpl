#!/usr/bin/env python3
"""Generated by CHPC_python_helper."""
import logging
import os
import shutil
import subprocess
import sys
import time

logging.Formatter.converter = time.gmtime
logging.basicConfig(level=logging.INFO, format="[%(asctime)sZ] %(message)s", datefmt="%Y-%m-%dT%H:%M:%S")
log = logging.getLogger(__name__)

MOUNTS = {{MOUNT_LIST}}.split()
MIN_FREE_PERCENT = {{MIN_FREE_PERCENT}}


def is_mounted(path: str) -> bool:
    result = subprocess.run(["mountpoint", "-q", path])
    return result.returncode == 0


def main() -> int:
    problems = 0
    for mnt in MOUNTS:
        if not os.path.isdir(mnt) or not is_mounted(mnt):
            log.error("PROBLEM: %s is not mounted", mnt)
            problems += 1
            continue

{{#CHECK_WRITABLE}}
        test_file = os.path.join(mnt, f".chpc_mount_check.{os.getpid()}")
        try:
            with open(test_file, "w"):
                pass
            os.remove(test_file)
        except OSError:
            log.error("PROBLEM: %s is not writable", mnt)
            problems += 1
{{/CHECK_WRITABLE}}

        if MIN_FREE_PERCENT > 0:
            usage = shutil.disk_usage(mnt)
            free_percent = int(usage.free / usage.total * 100) if usage.total else 0
            if free_percent < MIN_FREE_PERCENT:
                log.error("PROBLEM: %s has only %d%% free (need >= %d%%)", mnt, free_percent, MIN_FREE_PERCENT)
                problems += 1

    if problems > 0:
        log.error("%d problem(s) found.", problems)
        return 1
    log.info("All mount points OK.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
