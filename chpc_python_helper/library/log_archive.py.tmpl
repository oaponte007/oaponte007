import logging
import os
import sys
import tarfile
import time

logging.Formatter.converter = time.gmtime
logging.basicConfig(level=logging.INFO, format="[%(asctime)sZ] %(message)s", datefmt="%Y-%m-%dT%H:%M:%S")
log = logging.getLogger(__name__)

LOG_DIR = {{LOG_DIR}}
MAX_AGE_DAYS = {{MAX_AGE_DAYS}}
ARCHIVE_DIR = {{ARCHIVE_DIR}}


def main() -> int:
    os.makedirs(ARCHIVE_DIR, exist_ok=True)
    cutoff = time.time() - MAX_AGE_DAYS * 86400
    old_files = []
    for name in os.listdir(LOG_DIR):
        path = os.path.join(LOG_DIR, name)
        if os.path.isfile(path) and os.path.getmtime(path) < cutoff:
            old_files.append(path)

    if not old_files:
        log.info("No files older than %dd in %s.", MAX_AGE_DAYS, LOG_DIR)
        return 0

    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    archive_path = os.path.join(ARCHIVE_DIR, f"logs-{stamp}.tar.gz")
    log.info("Archiving %d file(s) into %s", len(old_files), archive_path)
    with tarfile.open(archive_path, "w:gz") as tar:
        for path in old_files:
            tar.add(path, arcname=os.path.basename(path))

{{#DELETE_ORIGINALS}}
    log.info("Removing originals")
    for path in old_files:
        os.remove(path)
{{/DELETE_ORIGINALS}}

    log.info("Done. Archive: %s", archive_path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
