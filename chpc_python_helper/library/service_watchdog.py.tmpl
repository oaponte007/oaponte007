#!/usr/bin/env python3
"""Generated by CHPC_python_helper."""
import logging
import subprocess
import sys
import time

logging.Formatter.converter = time.gmtime
logging.basicConfig(level=logging.INFO, format="[%(asctime)sZ] %(message)s", datefmt="%Y-%m-%dT%H:%M:%S")
log = logging.getLogger(__name__)

SERVICE = {{SERVICE_NAME}} + ".service"
MAX_ATTEMPTS = {{MAX_RESTART_ATTEMPTS}}
DELAY = {{RETRY_DELAY_SECONDS}}


def is_active() -> bool:
    result = subprocess.run(["systemctl", "is-active", "--quiet", SERVICE])
    return result.returncode == 0


def main() -> int:
    if is_active():
        log.info("%s is active. Nothing to do.", SERVICE)
        return 0

    log.info("%s is not active. Attempting to restart (up to %d time(s)).", SERVICE, MAX_ATTEMPTS)
    for attempt in range(1, MAX_ATTEMPTS + 1):
        log.info("Restart attempt %d/%d", attempt, MAX_ATTEMPTS)
        subprocess.run(["systemctl", "restart", SERVICE])
        time.sleep(DELAY)
        if is_active():
            log.info("%s is active again after attempt %d.", SERVICE, attempt)
            return 0

    log.error("%s did not come back up after %d attempt(s).", SERVICE, MAX_ATTEMPTS)
{{#ALERT_VIA_LOGGER}}
    subprocess.run(["logger", "-p", "daemon.err", "-t", "chpc-python-helper",
                    f"watchdog: {SERVICE} failed to restart after {MAX_ATTEMPTS} attempt(s)"])
{{/ALERT_VIA_LOGGER}}
    return 1


if __name__ == "__main__":
    sys.exit(main())
