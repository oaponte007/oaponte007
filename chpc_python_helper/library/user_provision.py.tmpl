#!/usr/bin/env python3
"""Generated by CHPC_python_helper."""
import grp
import logging
import os
import pwd
import subprocess
import sys
import time

logging.Formatter.converter = time.gmtime
logging.basicConfig(level=logging.INFO, format="[%(asctime)sZ] %(message)s", datefmt="%Y-%m-%dT%H:%M:%S")
log = logging.getLogger(__name__)

USERNAME = {{USERNAME}}
GROUP = {{PRIMARY_GROUP}}
SSH_KEY = {{SSH_PUBLIC_KEY}}


def user_exists(username: str) -> bool:
    try:
        pwd.getpwnam(username)
        return True
    except KeyError:
        return False


def main() -> int:
    if user_exists(USERNAME):
        log.info("%s already exists; updating.", USERNAME)
        if GROUP:
            subprocess.run(["usermod", "-aG", GROUP, USERNAME], check=True)
    else:
        log.info("Creating %s.", USERNAME)
        cmd = ["useradd", "-m"]
        if GROUP:
            cmd += ["-G", GROUP]
        cmd.append(USERNAME)
        subprocess.run(cmd, check=True)

{{#DISABLE_PASSWORD_LOGIN}}
    log.info("Locking password login for %s (SSH key only).", USERNAME)
    subprocess.run(["passwd", "-l", USERNAME], check=True)
{{/DISABLE_PASSWORD_LOGIN}}

    if SSH_KEY:
        home_dir = pwd.getpwnam(USERNAME).pw_dir
        ssh_dir = os.path.join(home_dir, ".ssh")
        authorized_keys = os.path.join(ssh_dir, "authorized_keys")
        log.info("Installing SSH key into %s", authorized_keys)
        os.makedirs(ssh_dir, mode=0o700, exist_ok=True)
        existing = ""
        if os.path.exists(authorized_keys):
            with open(authorized_keys) as f:
                existing = f.read()
        if SSH_KEY not in existing.splitlines():
            with open(authorized_keys, "a") as f:
                f.write(SSH_KEY + "\n")
        os.chmod(authorized_keys, 0o600)
        uid = pwd.getpwnam(USERNAME).pw_uid
        try:
            gid = grp.getgrnam(USERNAME).gr_gid
        except KeyError:
            gid = pwd.getpwnam(USERNAME).pw_gid
        os.chown(ssh_dir, uid, gid)
        os.chown(authorized_keys, uid, gid)

    log.info("Done.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
