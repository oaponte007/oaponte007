#!/usr/bin/env python3
"""Generated by CHPC_python_helper."""
import logging
import os
import platform
import shutil
import socket
import subprocess
import sys
import tarfile
import tempfile
import time

logging.Formatter.converter = time.gmtime
logging.basicConfig(level=logging.INFO, format="[%(asctime)sZ] %(message)s", datefmt="%Y-%m-%dT%H:%M:%S")
log = logging.getLogger(__name__)

OUTPUT_DIR = {{OUTPUT_DIR}}


def _run(cmd: list) -> str:
    try:
        result = subprocess.run(cmd, capture_output=True, text=True)
        return result.stdout + result.stderr
    except FileNotFoundError:
        return f"{cmd[0]} not available\n"


def main() -> int:
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    hostname = socket.gethostname().split(".")[0]
    workdir = tempfile.mkdtemp()
    bundle = os.path.join(OUTPUT_DIR, f"diag-{hostname}-{stamp}.tar.gz")

    try:
        log.info("Collecting system info")
        with open(os.path.join(workdir, "system_info.txt"), "w") as f:
            f.write(f"== platform.uname() ==\n{platform.uname()}\n")
            try:
                with open("/etc/os-release") as osr:
                    f.write("\n== os-release ==\n" + osr.read())
            except OSError:
                pass

        with open(os.path.join(workdir, "disk.txt"), "w") as f:
            f.write(_run(["df", "-h"]))
        with open(os.path.join(workdir, "network.txt"), "w") as f:
            f.write(_run(["ip", "addr"]))
        with open(os.path.join(workdir, "processes.txt"), "w") as f:
            f.write(_run(["ps", "aux"]))
        with open(os.path.join(workdir, "dmesg.txt"), "w") as f:
            f.write(_run(["dmesg"]))

{{#INCLUDE_JOURNAL}}
        log.info("Collecting journal (last 500 lines)")
        with open(os.path.join(workdir, "journal.txt"), "w") as f:
            f.write(_run(["journalctl", "-n", "500", "--no-pager"]))
{{/INCLUDE_JOURNAL}}

{{#INCLUDE_SCHEDULER_STATUS}}
        log.info("Collecting scheduler status (if present)")
        with open(os.path.join(workdir, "scheduler_status.txt"), "w") as f:
            if shutil.which("sinfo"):
                f.write(_run(["sinfo", "-N", "-l"]))
            elif shutil.which("pbsnodes"):
                f.write(_run(["pbsnodes", "-a"]))
            else:
                f.write("No Slurm or PBS scheduler commands found.\n")
{{/INCLUDE_SCHEDULER_STATUS}}

        log.info("Building %s", bundle)
        with tarfile.open(bundle, "w:gz") as tar:
            tar.add(workdir, arcname=".")
        log.info("Done: %s", bundle)
    finally:
        shutil.rmtree(workdir, ignore_errors=True)

    return 0


if __name__ == "__main__":
    sys.exit(main())
