import logging
import os
import shutil
import subprocess
import sys
import time

logging.Formatter.converter = time.gmtime
logging.basicConfig(level=logging.INFO, format="[%(asctime)sZ] %(message)s", datefmt="%Y-%m-%dT%H:%M:%S")
log = logging.getLogger(__name__)

SOURCES = {{SOURCE_PATHS}}.split()
DEST_BASE = {{DEST_BASE}}
RETENTION = {{RETENTION_COUNT}}
EXCLUDES = {{EXCLUDE_PATTERNS}}.split()


def main() -> int:
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    dest_dir = os.path.join(DEST_BASE, stamp)
    os.makedirs(dest_dir, exist_ok=True)

    cmd = ["rsync", "-a"]
{{#COMPRESS}}
    cmd.append("-z")
{{/COMPRESS}}
    for pattern in EXCLUDES:
        cmd += ["--exclude", pattern]
    cmd += SOURCES + [dest_dir + "/"]

    log.info("Backing up to %s", dest_dir)
    subprocess.run(cmd, check=True)

    if RETENTION > 0:
        log.info("Pruning to the %d most recent dated backup(s) in %s", RETENTION, DEST_BASE)
        entries = sorted(
            (p for p in os.listdir(DEST_BASE) if os.path.isdir(os.path.join(DEST_BASE, p))),
            reverse=True,
        )
        for old in entries[RETENTION:]:
            old_path = os.path.join(DEST_BASE, old)
            log.info("Removing old backup %s", old_path)
            shutil.rmtree(old_path)

    log.info("Done. Backup at %s", dest_dir)
    return 0


if __name__ == "__main__":
    sys.exit(main())
